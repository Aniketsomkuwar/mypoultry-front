{
  "expo": {
    "name": "MyPoultry",
    "slug": "mypoultry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aniketsomkuwar1101steam.mypoultry"
    },
    "android": {
      "package": "com.aniketsomkuwar1101steam.mypoultry",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E20",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "952b050a-20e6-464d-b9ea-d98f71a601d6"
      }
    },
    "owner": "aniketsomkuwar1101s-team"
  }
}
